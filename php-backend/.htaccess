# Apache .htaccess for ArtBloom PHP API
# Place this file in the root of your uploaded php-backend folder on ProFreeHost

Options -Indexes
DirectoryIndex health.php

# ── Security Headers ──────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options    "nosniff"
    Header always set X-Frame-Options           "DENY"
    Header always set X-XSS-Protection          "1; mode=block"
    Header always set Referrer-Policy           "strict-origin-when-cross-origin"
</IfModule>

# ── Rewrite Engine ────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow real files and directories to pass through
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── Auth routes ───────────────────────────────────────────
    RewriteRule ^api/auth/register/?$   api/auth/register.php  [QSA,L]
    RewriteRule ^api/auth/login/?$      api/auth/login.php     [QSA,L]
    RewriteRule ^api/auth/logout/?$     api/auth/logout.php    [QSA,L]
    RewriteRule ^api/auth/me/?$         api/auth/me.php        [QSA,L]

    # ── User routes ───────────────────────────────────────────
    RewriteRule ^api/users/profile/?$   api/users/profile.php  [QSA,L]
    RewriteRule ^api/users/password/?$  api/users/password.php [QSA,L]
    # GET /api/users/:id  →  users/profile.php?id=:id
    RewriteRule ^api/users/([0-9]+)/?$  api/users/profile.php?id=$1 [QSA,L]

    # ── Children routes ───────────────────────────────────────
    RewriteRule ^api/children/?$              api/children/index.php         [QSA,L]
    RewriteRule ^api/children/([0-9]+)/?$     api/children/single.php?id=$1  [QSA,L]

    # ── Artwork routes ────────────────────────────────────────
    RewriteRule ^api/artworks/?$              api/artworks/index.php         [QSA,L]
    RewriteRule ^api/artworks/upload/?$       api/artworks/upload.php        [QSA,L]
    RewriteRule ^api/artworks/([0-9]+)/like/?$  api/artworks/single.php?id=$1&action=like [QSA,L]
    RewriteRule ^api/artworks/([0-9]+)/view/?$  api/artworks/single.php?id=$1&action=view [QSA,L]
    RewriteRule ^api/artworks/([0-9]+)/?$     api/artworks/single.php?id=$1  [QSA,L]

    # ── Comment routes ────────────────────────────────────────
    RewriteRule ^api/comments/?$              api/comments/index.php         [QSA,L]

    # ── Forum routes ──────────────────────────────────────────
    RewriteRule ^api/forum/?$                 api/forum/index.php            [QSA,L]
    RewriteRule ^api/forum/([0-9]+)/upvote/?$ api/forum/single.php?id=$1&action=upvote  [QSA,L]
    RewriteRule ^api/forum/([0-9]+)/comment/?$ api/forum/single.php?id=$1&action=comment [QSA,L]
    RewriteRule ^api/forum/([0-9]+)/?$        api/forum/single.php?id=$1     [QSA,L]

    # ── Admin routes ──────────────────────────────────────────
    RewriteRule ^api/admin/dashboard/?$       api/admin/dashboard.php        [QSA,L]
    RewriteRule ^api/admin/users/?$           api/admin/users.php            [QSA,L]
    RewriteRule ^api/admin/artworks/?$        api/admin/artworks.php         [QSA,L]

    # ── Health check ──────────────────────────────────────────
    RewriteRule ^api/health/?$                api/health.php                 [QSA,L]
</IfModule>

# ── PHP Settings ──────────────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize  10M
    php_value post_max_size        10M
    php_value max_execution_time   60
    php_value memory_limit         128M
</IfModule>
